<resources>
    <!--
      Turbo Android 7 draws its own fragment layouts (turbo_view, the web fragment
      toolbar) without applying window insets, so the edge-to-edge enforcement that
      Android 15 applies to targetSdk 35 apps would push the toolbar under the status
      bar. Opt out until the app moves to Hotwire Native, whose layouts are inset-aware.
    -->
    <style name="Theme.FitPlanAndroid" parent="Base.Theme.FitPlanAndroid">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
